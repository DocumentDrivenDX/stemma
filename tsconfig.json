{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@stemma/records": ["./packages/records/src/index.ts"],
      "@stemma/core": ["./packages/core/src/index.ts"],
      "@stemma/extract": ["./packages/extract/src/index.ts"],
      "@stemma/workspace": ["./packages/workspace/src/index.ts"],
      "@stemma/graph": ["./packages/graph/src/index.ts"]
    },
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": ["packages/*/src", "packages/explorer/build.ts", "scripts", "tests", "website/*.ts", "website/lib", "website/e2e"]
}
