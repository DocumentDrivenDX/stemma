{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@stemma/records": ["./packages/records/src/index.ts"],
      "@stemma/core": ["./packages/core/src/index.ts"],
      "@stemma/workspace": ["./packages/workspace/src/index.ts"]
    },
    "skipLibCheck": true
  },
  "include": ["packages/*/src", "scripts", "tests"]
}
